# Throwaway spike worker image: same dependencies as the host venv, Linux runtime.
FROM python:3.13-slim
RUN pip install --no-cache-dir uv==0.12.5
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
# spike/ is mounted read-only at run time so code edits need no rebuild.
