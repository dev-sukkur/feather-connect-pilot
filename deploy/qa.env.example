# Copy to deploy/qa.env and fill in. No value here is a real secret. Its own key: never the other environment's.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEATHER_SECRET_KEY=
# feather_qa's password is QA_DB_PASSWORD in nonprod.env.
FEATHER_DATABASE_URL=postgresql://feather_qa:CHANGE-ME@postgres:5432/feather_qa
FEATHER_ENV=qa
FEATHER_BASE_URL=http://127.0.0.1:8180
FEATHER_LOG_LEVEL=INFO
