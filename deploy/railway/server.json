{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile.server",
    "watchPatterns": ["packages/**", "templates/**", "examples/demo/**", "pyproject.toml", "uv.lock", "deploy/Dockerfile.server", "deploy/railway/server.json"]
  },
  "deploy": {
    "preDeployCommand": ["feather server migrate"],
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
