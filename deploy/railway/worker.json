{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile.worker",
    "watchPatterns": ["packages/**", "templates/**", "examples/demo/**", "pyproject.toml", "uv.lock", "deploy/Dockerfile.worker", "deploy/railway/worker.json"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
