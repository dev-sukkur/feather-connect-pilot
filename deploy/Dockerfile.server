# The Feather server: the dashboard, the JSON API, ingress and the scheduler.
#   docker build -f deploy/Dockerfile.server -t ghcr.io/${FEATHER_IMAGE_ORG:-feather-connect}/feather-server .
# It runs as a non-root user and holds no secrets: FEATHER_SECRET_KEY and the database URL come at run time.
# The project it serves is mounted at /project (compose.yaml mounts examples/demo by default).

FROM python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/feather/venv
WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY packages packages
COPY templates templates
RUN uv sync --frozen --no-dev --all-packages --no-editable

FROM python:3.13-slim
# Debian's security fixes that came after the base image was built, and no pip: nothing runs it here, and the
# libraries it vendors are what scanners flag (M3 X2).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip
RUN groupadd --system --gid 10001 feather && useradd --system --uid 10001 --gid feather --home-dir /home/feather --create-home feather
COPY --from=build /opt/feather/venv /opt/feather/venv
COPY --chown=feather:feather examples/demo /project
ENV PATH=/opt/feather/venv/bin:$PATH PYTHONUNBUFFERED=1 FEATHER_PROJECT=/project FEATHER_ENV=dev
USER feather
WORKDIR /project
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=12 \
  CMD ["python", "-c", "import urllib.request, sys; sys.exit(urllib.request.urlopen('http://127.0.0.1:8080/readyz', timeout=2).status != 200)"]
ENTRYPOINT ["feather"]
CMD ["server", "--host", "0.0.0.0", "--port", "8080"]
