# Copy to deploy/nonprod.env and fill in. No value here is a real secret.
# The Postgres superuser, and the two environments' database users (their passwords again in qa.env and uat.env).
POSTGRES_PASSWORD=
QA_DB_PASSWORD=
UAT_DB_PASSWORD=
FEATHER_IMAGE_ORG=feather-connect
FEATHER_VERSION=dev
QA_PORT=8180
UAT_PORT=8280
