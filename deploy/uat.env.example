# Copy to deploy/uat.env and fill in. No value here is a real secret. Its own key: never the other environment's.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEATHER_SECRET_KEY=
# feather_uat's password is UAT_DB_PASSWORD in nonprod.env.
FEATHER_DATABASE_URL=postgresql://feather_uat:CHANGE-ME@postgres:5432/feather_uat
FEATHER_ENV=uat
FEATHER_BASE_URL=http://127.0.0.1:8280
FEATHER_LOG_LEVEL=INFO
