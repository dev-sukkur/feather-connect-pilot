# Copy to deploy/.env and fill in. No value here is a real secret.
# A long random key that signs sessions and confirmations; every replica must share it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEATHER_SECRET_KEY=
POSTGRES_PASSWORD=
# The organisation of the images on ghcr.io, until discovery Q9 names it.
FEATHER_IMAGE_ORG=feather-connect
FEATHER_VERSION=dev
FEATHER_PORT=8080
FEATHER_BASE_URL=http://127.0.0.1:8080
FEATHER_WORKERS=1
# The flow project to serve and run: a folder holding feather.yaml.
FEATHER_PROJECT_DIR=../examples/demo
FEATHER_ENV=qa
